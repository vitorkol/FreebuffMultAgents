{
  "name": "@biome/design-system",
  "version": "0.4.8",
  "private": false,
  "description": "Biome Design System — componentes e tokens reutilizáveis.",
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "tailwindcss",
    "radix-ui"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://git.meioambiente.mg.gov.br/semad/biome.git"
  },
  "publishConfig": {
    "registry": "https://nexus.meioambiente.mg.gov.br/repository/npm-hosted/"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "typography.json",
    "figma-tokens",
    "tokens",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./consumption-foundations.css": "./dist/consumption-foundations.css",
    "./typography.json": "./typography.json",
    "./figma-tokens/figma-tokens.json": "./figma-tokens/figma-tokens.json",
    "./tokens/global.json": "./tokens/global.json",
    "./tokens/light.json": "./tokens/light.json",
    "./tokens/dark.json": "./tokens/dark.json",
    "./tokens/primitives.json": "./tokens/primitives.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:eslint-rule": "esbuild eslint-rules/no-manual-typography.ts --bundle --packages=external --platform=node --format=cjs --outfile=eslint-rules/no-manual-typography.js",
    "build:docker-serve": "esbuild docker/serve.ts --platform=node --format=esm --outfile=docker/serve.mjs",
    "build": "pnpm build:eslint-rule && tsup src/index.ts --dts --format cjs,esm --sourcemap --out-dir dist && pnpm build:css",
    "build:css": "npx @tailwindcss/cli -i src/styles.css -o dist/styles.css --minify && cp src/tokens.css dist/tokens.css && cp src/consumption-foundations.css dist/consumption-foundations.css && mkdir -p dist/utilities && cp src/utilities/structural-utilities.css dist/utilities/structural-utilities.css",
    "governance:typography-contract": "tsx scripts/governance/validate-typography-contract.ts",
    "governance:typography-display-as": "pnpm run governance:typography",
    "governance:typography": "tsx scripts/governance/enforce-typography-usage.ts",
    "governance:comments": "tsx scripts/governance/comment-quality-check.ts",
    "governance:typography-regression": "tsx scripts/governance/typography-regression-check.ts",
    "test": "pnpm test:vitest && pnpm test:eslint-rule",
    "test:vitest": "vitest run",
    "pretest": "pnpm build:eslint-rule",
    "test:eslint-rule": "tsx eslint-rules/no-manual-typography.test.ts",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "export:figma-tokens": "node scripts/export-figma-tokens.mjs",
    "governance:semantic-layer": "node scripts/generate-semantic-layer-reports.mjs",
    "export:tokens:w3c": "node scripts/export-figma-tokens.mjs --from-json",
    "validate:commit": "pnpm typecheck && pnpm governance:typography && pnpm governance:comments && pnpm governance:typography-regression && pnpm test && pnpm build",
    "prepublishOnly": "pnpm validate:commit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "embla-carousel-react": "^8.5.1",
    "lucide-react": "^1.21.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.5.3",
    "@storybook/addon-interactions": "^8.5.3",
    "@storybook/react": "^8.5.3",
    "@storybook/react-vite": "^8.5.3",
    "@storybook/test": "^8.5.3",
    "@storybook/theming": "^8.6.14",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/eslint": "^8.56.10",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "happy-dom": "^17.4.4",
    "husky": "^9.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.5.3",
    "tailwindcss": "^4",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.0"
  }
}
